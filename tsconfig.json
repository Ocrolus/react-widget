{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "typeRoots": ["./node_modules/@types", "src/types/typings"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowUmdGlobalAccess": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationDir": "types",
    "sourceMap": true,
    "outDir": "dist",
    "emitDeclarationOnly": true,
    "baseUrl": "./",
    "paths": {
      "@ocrolus-widget-react/*": ["packages/ocrolus-widget-react/*"],
      "@example/*": ["packages/example/*"]
    }
  },
  "include": [
    "packages/ocrolus-widget-react/src/**/*.ts",
    "packages/ocrolus-widget-react/src/**/*.tsx",
    "packages/ocrolus-widget-react/src/**/*.d.ts",
    "packages/example/src/**/*.ts",
    "packages/example/src/**/*.tsx",
    "packages/example/src/**/*.d.ts"
  ],
  "exclude": ["node_modules", "**/*.test.tsx", "**/*.test.ts"]
}
